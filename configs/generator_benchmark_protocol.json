{
  "schema_version": 2,
  "protocol_version": 2.1,
  "gate_note": "Perceptual-hash-only rate and RAD-DINO coverage are descriptive ranking metrics, not binary gates. Other gates define eligibility for this project ranking only; they do not certify pathology, radiological validity, or clinical realism.",
  "study_question": "RQ1: Which eligible fine-tuned generator and which eligible from-scratch generator best satisfy the declared fidelity, diversity, coverage, duplication, and detected train-reference memorization criteria?",
  "primary_class": "positive",
  "synthetic_pool_target": 1361,
  "real_reference_count": "all_available_validation_positives",
  "evaluation_subset_size": "KID/FID: all real validation positives versus the canonical 1361 synthetic pool; PRDC point: all real positives versus an equal-size deterministic synthetic subset; stability: balanced 80% subsets",
  "sampling": {
    "seed": 20260714,
    "without_replacement": true,
    "record_selected_ids": true
  },
  "reference_sets": {
    "distribution_metrics": "data/processed/metadata/val.csv:positive_only",
    "train_memorization": "processed_train_and_traditional_augmentation_metadata",
    "validation_similarity": "data/processed/metadata/val.csv:positive_only",
    "forbidden_splits": ["test", "historical_internal_test"]
  },
  "representations": ["raw", "filtered"],
  "comparison_rule": "Compare raw only with raw and filtered only with filtered; never mix representations in one ranking table.",
  "technical_validity_policy": {
    "feature_extractable_definition": "readable, expected shape, non-empty finite numeric array",
    "quality_valid_definition": "feature-extractable and neither near-black nor constant-range",
    "raw": {
      "near_black": "warning_and_include",
      "constant_range": "warning_and_include",
      "corrupt": "fatal_for_raw_representation",
      "wrong_shape": "fatal_for_raw_representation",
      "minimum_feature_extractable_images": 1361,
      "minimum_unique_feature_extractable_content": 1361
    },
    "filtered": {
      "near_black": "fatal_for_official_ranking",
      "constant_range": "fatal_for_official_ranking",
      "corrupt": "fatal",
      "wrong_shape": "fatal",
      "minimum_quality_valid_images": 1361,
      "minimum_unique_quality_valid_content": 1361,
      "maximum_exact_duplicate_rate_source": "eligibility_gates.maximum_exact_duplicate_rate"
    },
    "continuation_rule": "continue only when at least one official FILTERED candidate remains in each scientific family"
  },
  "feature_spaces": {
    "inception_v3": {
      "role": "secondary standard-literature continuity",
      "metrics": ["fid", "kid", "precision", "recall", "density", "coverage"]
    },
    "rad_dino": {
      "role": "primary frozen medical-image feature extractor",
      "metrics": ["fid", "kid", "precision", "recall", "density", "coverage"],
      "frozen": true,
      "downstream_classifier": false,
      "limitation": "RAD-DINO is radiology-specific, not mammography-specific."
    }
  },
  "resampling": {
    "subsampling_fraction": 0.8,
    "stability_repetitions": 200,
    "kid_repetitions": 200,
    "prdc_repetitions": 100,
    "fid_repetitions": 1,
    "nearest_neighbour_k": 5,
    "replace": false,
    "percentiles": [2.5, 97.5],
    "interval_terminology": "repeated-subsampling stability interval",
    "shared_plan": "same real indices, subset size, seed schedule and representation policy for every generator",
    "report": ["mean", "median", "standard_deviation", "percentile_2_5", "percentile_97_5", "valid_repetitions"]
  },
  "embedding_cache": {
    "root": "results/2_diffusers/benchmark/embedding_cache",
    "key_fields": ["generator_id", "representation", "extractor"],
    "metadata_fields": ["schema_version", "image_ids", "image_paths", "image_fingerprints", "extractor", "extractor_model_id", "extractor_weights_identifier", "extractor_identity", "extractor_identity_sha256", "preprocessing_signature", "feature_dimension", "code_version", "source_manifest_path", "source_manifest_sha256", "metadata_csv_sha256"]
  },
  "memorization": {
    "train_pool": "processed_train_and_traditional_augmentation_metadata",
    "validation_pool": "real_validation_positive",
    "synthetic_pool": "synthetic_same_candidate",
    "forbidden_pool": "test",
    "flag_rule": {"ssim_gte": 0.98, "perceptual_hash_distance_lte": 2},
    "gate_uses_train_only": true
  },
  "eligibility_gates": {
    "minimum_valid_positive_images": 1361,
    "maximum_exact_duplicate_rate": 0.01,
    "maximum_train_memorization_rate": 0.01,
    "maximum_corrupted_file_rate": 0.0,
    "require_complete_metrics": true,
    "forbid_test_access": true
  },
  "descriptive_reference_values": {
    "maximum_perceptual_duplicate_rate": 0.02,
    "minimum_rad_dino_coverage": 0.5,
    "note": "These values support descriptive interpretation and ranking; they are not eligibility gates."
  },
  "selection": {
    "official_representation": "filtered",
    "one_per_family": ["finetuned", "from_scratch"],
    "primary_metric": "raddino_kid",
    "fid_role": "secondary_descriptive",
    "weighted_composite_score": false,
    "practical_equivalence_margin": 0.001,
    "practical_equivalence_rule": "paired stability interval includes zero and absolute paired mean difference is no greater than the protocol-defined margin",
    "efficiency_role": "reported separately; not an eligibility gate or ranking field",
    "ranking": [
      {"metric": "raddino_kid", "direction": "min"},
      {"metric": "raddino_coverage", "direction": "max"},
      {"metric": "raddino_precision", "direction": "max"},
      {"metric": "raddino_fid", "direction": "min", "role": "descriptive_tiebreak"},
      {"metric": "inception_kid", "direction": "min"},
      {"metric": "raddino_kid_std", "direction": "min"},
      {"metric": "generator_id", "direction": "lexicographic"}
    ],
    "manual_selection_required": true
  },
  "outputs": {
    "root": "results/2_diffusers/benchmark",
    "candidate_audit": "results/2_diffusers/benchmark/candidate_audit.csv",
    "technical_validity": "results/2_diffusers/benchmark/technical_validity.csv",
    "metrics": "results/2_diffusers/benchmark/generator_summary.csv",
    "ranking": "results/2_diffusers/benchmark/generator_ranking.csv",
    "resampling": "results/2_diffusers/benchmark/distribution_metrics_repetitions.csv",
    "resampling_plan": "results/2_diffusers/benchmark/resampling_plan.json",
    "paired_differences": "results/2_diffusers/benchmark/paired_generator_differences.csv",
    "distribution_summary": "results/2_diffusers/benchmark/distribution_metrics_summary.csv",
    "diversity": "results/2_diffusers/benchmark/diversity_metrics.csv",
    "train_memorization": "results/2_diffusers/benchmark/train_memorization.csv",
    "validation_similarity": "results/2_diffusers/benchmark/validation_similarity.csv",
    "synthetic_duplication": "results/2_diffusers/benchmark/synthetic_duplication.csv"
  }
}
