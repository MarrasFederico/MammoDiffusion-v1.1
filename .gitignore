# ================================
# DIFFUSION EXPERIMENTS - entire directories (too large for GitHub)
# ================================
# Fine-tuning Stable Diffusion (notebook 03a/03b/03c/03d):
#   03a -> 20260607_sd21_rsna_mlo_512
#   03b -> 20260611_sd21_rsna_mlo_512_inference_100_steps
#   03c -> 20260706_sd21_vaeft_extra1361
#   03d -> 20260707_sd21_lora_finetuning
experiments/*_sd21_*/
# LDM Keras from scratch (notebook 04a/04b/04b1/04b2/04b3):
#   04a  -> 20260617_ldm_basic
#   04b* -> ..._ldm_keras_v2_extra1361, 20260703_ldm_sdvae_extra1361, 20260707_ldm_v3_sdvae_extra1361
experiments/*_ldm_*/
# Current layout: diffusion experiment directories contain very large repositories, caches,
# and checkpoints. Code and metrics remain under notebooks/ and results/.
experiments/diffusers/
# 04d outputs (sampling optimization for a source LDM)
experiments/04d_ldm_*/
# Classifier directories matching experiments/exp_maxvit512_*, experiments/exp_mammofm_*,
# experiments/exp_raddino_*, and experiments/compare_22c_* remain tracked.
# Publication-oriented classifiers: local checkpoint/resume state for 24 jobs.
experiments/classifiers/
# Local outputs from the archived full matrix remain recoverable but are not active/tracked.
experiments/classifiers_matrix/
results/classifiers_matrix/
results/runtime_profiles/

