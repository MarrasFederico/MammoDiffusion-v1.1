{
  "experiment_name": "exp20260619_full_synth_resnet50_fine_tuned_batch_size_16",
  "date": "2026-06-19",
  "backbone": {
    "name": "ResNet-50",
    "weights": "imagenet",
    "input_shape": [
      224,
      224,
      3
    ],
    "include_top": false
  },
  "head": {
    "pooling": "GlobalAveragePooling2D",
    "dense_units": 256,
    "l2_regularization": 0.0001,
    "activation": "LeakyReLU(negative_slope=0.1)",
    "dropout": 0.5,
    "output": "Dense(1, sigmoid)"
  },
  "preprocessing": {
    "img_size": [
      224,
      224
    ],
    "normalization": "ImageNet mean/std",
    "imagenet_mean": [
      0.485,
      0.456,
      0.406
    ],
    "imagenet_std": [
      0.229,
      0.224,
      0.225
    ]
  },
  "data": {
    "batch_size": 16,
    "seed": 42,
    "augmentation": false,
    "train_csv": "../data/synthetic/metadata/train_synthetic_ft_dataset.csv",
    "val_csv": "../data/processed/metadata/val.csv"
  },
  "phase1_head_training": {
    "optimizer": "Adam",
    "learning_rate": 0.001,
    "loss": "binary_crossentropy",
    "max_epochs": 25,
    "early_stopping_monitor": "val_auc",
    "early_stopping_patience": 7,
    "class_weight": "balanced",
    "backbone_trainable": false
  },
  "phase2_fine_tuning": {
    "optimizer": "Adam",
    "learning_rate": 1e-05,
    "loss": "BinaryFocalCrossentropy",
    "BinaryFocalCrossentropy_gamma": 2.0,
    "BinaryFocalCrossentropy_alpha": 0.75,
    "max_epochs": 30,
    "fine_tune_from_layer": "conv4_block5_1_conv",
    "early_stopping_monitor": "val_auc",
    "early_stopping_patience": 5,
    "early_stopping_min_delta": 0.001,
    "reduce_lr_factor": 0.5,
    "reduce_lr_patience": 3,
    "min_lr": 1e-07,
    "class_weight": "none"
  }
}