{
  "schema_version": 1,
  "pipeline_namespace": "mammodiffusion.downstream_validation.v1",
  "research_questions": {
    "RQ2": "Does adding positive synthetic mammograms improve classification over real-only data and traditional augmentation?",
    "RQ3": "Is the effect consistent across a modern general-purpose classifier and a mammography-specific foundation model?"
  },
  "architectures": {
    "maxvit512": {
      "display_name": "MaxViT-512",
      "role": "modern general-purpose convolution/transformer backbone",
      "framework": "pytorch_timm",
      "backbone": "maxvit_tiny_tf_512.in1k",
      "checkpoint_base": "in1k",
      "input_size": [512, 512],
      "preprocessing": "timm_pretrained_cfg_resize_center_crop",
      "normalization": {"mean": [0.5, 0.5, 0.5], "std": [0.5, 0.5, 0.5]},
      "positive_class": 1,
      "head": "timm_default_classifier_head_binary",
      "training_phases": [{"name": "full_run", "freeze": "partial_finetuning_fixed", "optimizer": "AdamW", "learning_rate": 0.0001, "loss": "binary_focal_loss"}],
      "weight_decay": 0.01,
      "scheduler": "ReduceLROnPlateau",
      "scheduler_params": {"monitor": "val_auc", "mode": "max", "factor": 0.5, "patience": 3, "min_lr": 1e-07},
      "warmup_updates": 200,
      "physical_batch_size": 8,
      "gradient_accumulation_steps": 2,
      "effective_batch_size": 16,
      "amp": true,
      "gradient_clipping": 1.0,
      "max_optimizer_updates": 6400,
      "checkpoint_interval_updates": 250,
      "max_epochs_secondary_limit": 60,
      "early_stopping": {"monitor": "val_auc", "mode": "max", "patience": 10, "restore_best_weights": true},
      "checkpoint_criterion": "val_auc_max",
      "class_weighting": "binary_focal_alpha_0.75",
      "loss": "binary_focal_loss",
      "dataloader_workers": 3,
      "cpu_threads": 4,
      "interpretability": ["Grad-CAM++", "SmoothGrad"]
    },
    "mammofm": {
      "display_name": "Mammo-FM",
      "role": "mammography-specific foundation model with domain pretraining",
      "framework": "pytorch",
      "backbone": "mammo_fm_efficientnet_b5",
      "checkpoint_base": "authorized_local_mammo_fm",
      "input_size": [512, 512],
      "preprocessing": "official_per_image_minmax_then_scalar_rgb_normalization",
      "normalization": {"mean": [0.3089279, 0.3089279, 0.3089279], "std": [0.25053555408335154, 0.25053555408335154, 0.25053555408335154]},
      "positive_class": 1,
      "head": "linear_binary_head_on_pooled_features",
      "training_phases": [{"name": "full_run", "freeze": "unfreeze_last_n_blocks_n2_fixed", "optimizer": "AdamW", "learning_rate": 5e-05, "loss": "binary_focal_loss"}],
      "weight_decay": 0.01,
      "scheduler": "ReduceLROnPlateau",
      "scheduler_params": {"monitor": "val_auc", "mode": "max", "factor": 0.5, "patience": 3, "min_lr": 1e-07},
      "warmup_updates": 200,
      "physical_batch_size": 8,
      "gradient_accumulation_steps": 2,
      "effective_batch_size": 16,
      "amp": true,
      "gradient_clipping": 1.0,
      "max_optimizer_updates": 6400,
      "checkpoint_interval_updates": 250,
      "max_epochs_secondary_limit": 60,
      "early_stopping": {"monitor": "val_auc", "mode": "max", "patience": 10, "restore_best_weights": true},
      "checkpoint_criterion": "val_auc_max",
      "class_weighting": "binary_focal_alpha_0.75",
      "loss": "binary_focal_loss",
      "dataloader_workers": 3,
      "cpu_threads": 4,
      "interpretability": ["architecture-compatible gradient attribution", "feature attribution"]
    }
  },
  "conditions": {
    "real_only": {"real_source": true, "augmentation_source": false, "synthetic_family": null},
    "real_augmented": {"real_source": true, "augmentation_source": true, "augmentation_classes": ["positive"], "synthetic_family": null},
    "real_plus_best_finetuned_positive": {"real_source": true, "augmentation_source": false, "synthetic_family": "finetuned", "synthetic_positive_count": 1361},
    "real_plus_best_fromscratch_positive": {"real_source": true, "augmentation_source": false, "synthetic_family": "from_scratch", "synthetic_positive_count": 1361}
  },
  "seeds": [17, 42, 73],
  "fairness": {
    "vary_only_added_training_data_within_architecture": true,
    "training_budget_policy": "fixed_maximum_optimizer_updates",
    "maximum_optimizer_updates": 6400,
    "validation_manifest": "data/processed/metadata/val.csv",
    "primary_checkpoint_metric": "validation_roc_auc",
    "real_image_augmentation_policy": "identical_within_architecture"
  },
  "evaluation": {
    "primary_metric": "pr_auc",
    "secondary_metrics": ["roc_auc", "sensitivity", "specificity", "sensitivity_at_fixed_specificity", "f1", "balanced_accuracy", "brier_score", "ece", "confusion_matrix"],
    "ensemble": {"seeds": [17, 42, 73], "method": "mean_probability", "primary_result": true},
    "confidence_intervals": {"method": "patient_level_bootstrap", "iterations": 2000, "seed": 20260714},
    "thresholds": "selected_on_validation_and_frozen_before_test",
    "primary_comparisons_per_architecture": [
      ["real_only", "real_augmented"],
      ["real_only", "real_plus_best_finetuned_positive"],
      ["real_only", "real_plus_best_fromscratch_positive"],
      ["real_plus_best_finetuned_positive", "real_plus_best_fromscratch_positive"]
    ],
    "multiple_testing": "Holm correction over the eight preregistered primary comparisons"
  },
  "locked_test": {
    "required_completed_jobs": 24,
    "required_ensembles": 8,
    "one_shot": true,
    "patient_level_aggregation": true,
    "post_test_model_selection": false,
    "post_test_threshold_tuning": false
  }
}
