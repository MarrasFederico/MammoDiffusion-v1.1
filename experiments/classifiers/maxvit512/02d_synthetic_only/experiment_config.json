{
  "experiment_name": "exp_maxvit512_full_synth",
  "date": "2026-07-03",
  "backbone": {
    "name": "maxvit_tiny_tf_512.in1k",
    "library": "timm",
    "weights": "in1k",
    "input_shape": [
      512,
      512,
      3
    ]
  },
  "head": {
    "type": "timm NormMlpClassifierHead",
    "pooling": "avg",
    "pre_logits": "Linear(512) + Tanh",
    "dropout": 0.0,
    "output": "Linear(1) [logits, BCEWithLogitsLoss]"
  },
  "preprocessing": {
    "img_size": [
      512,
      512
    ],
    "normalization": "mean=std=0.5 (timm in1k tf-style)"
  },
  "data": {
    "batch_size": 8,
    "seed": 42,
    "augmentation": false,
    "train_csv": "../data/synthetic/metadata/train_synthetic_ft_dataset.csv",
    "val_csv": "../data/processed/metadata/val.csv"
  },
  "phase1_head_training": {
    "optimizer": "Adam",
    "learning_rate": 0.001,
    "loss": "BCEWithLogitsLoss(pos_weight=balanced)",
    "max_epochs": 25,
    "early_stopping_monitor": "val_auc",
    "early_stopping_patience": 7,
    "backbone_trainable": false
  },
  "phase2_fine_tuning": {
    "optimizer": "Adam",
    "learning_rate": 1e-05,
    "loss": "BinaryFocalLoss(alpha=0.75, gamma=2.0)",
    "max_epochs": 30,
    "fine_tune_from": "stage 3/4 (ultimo stage)",
    "early_stopping_monitor": "val_auc",
    "early_stopping_patience": 5,
    "early_stopping_min_delta": 0.001,
    "reduce_lr_factor": 0.5,
    "reduce_lr_patience": 3,
    "min_lr": 1e-07
  }
}