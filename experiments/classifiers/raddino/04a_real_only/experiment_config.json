{
  "experiment_name": "exp_raddino_baseline",
  "date": "2026-07-06",
  "backbone": {
    "name": "microsoft/rad-dino",
    "library": "transformers",
    "pretraining": "radiographs/mammograms (self-supervised DINOv2)",
    "input_shape": [
      518,
      518,
      3
    ],
    "hidden_size": 768
  },
  "head": {
    "type": "Linear on CLS token",
    "dropout": 0.1,
    "output": "Linear(1) [logits, BCEWithLogitsLoss / BinaryFocalLoss]"
  },
  "preprocessing": {
    "img_size": [
      518,
      518
    ],
    "normalization": "ImageNet mean/std (grayscale replicato su 3 canali)"
  },
  "data": {
    "batch_size": 4,
    "seed": 42,
    "augmentation": false,
    "train_csv": "../data/processed/metadata/train.csv",
    "val_csv": "../data/processed/metadata/val.csv"
  },
  "phase1_head_training": {
    "optimizer": "Adam",
    "learning_rate": 0.001,
    "loss": "BCEWithLogitsLoss(pos_weight=balanced)",
    "max_epochs": 25,
    "early_stopping_monitor": "val_auc",
    "early_stopping_patience": 7,
    "backbone_trainable": false
  },
  "phase2_fine_tuning": {
    "optimizer": "Adam",
    "learning_rate": 1e-05,
    "loss": "BinaryFocalLoss(alpha=0.75, gamma=2.0)",
    "max_epochs": 30,
    "unfreeze": "ultimi 2 block ViT + layernorm",
    "early_stopping_monitor": "val_auc",
    "early_stopping_patience": 5,
    "early_stopping_min_delta": 0.001,
    "reduce_lr_factor": 0.5,
    "reduce_lr_patience": 3,
    "min_lr": 1e-07
  }
}