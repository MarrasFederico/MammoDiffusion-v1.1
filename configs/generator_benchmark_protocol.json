{
  "schema_version": 2,
  "pipeline_namespace": "mammodiffusion.generator_benchmark.v2",
  "study_question": "RQ1: Which eligible fine-tuned generator and which eligible from-scratch generator provide the best balance of fidelity, diversity, coverage, efficiency, and absence of train memorization?",
  "primary_class": "positive",
  "synthetic_pool_target": 1361,
  "real_reference_count": "all_available_validation_positives",
  "evaluation_subset_size": "floor(subsampling_fraction * min(real_reference_count, synthetic_pool_count)) for stability; all real references for point estimates",
  "sampling": {
    "seed": 20260714,
    "without_replacement": true,
    "record_selected_ids": true
  },
  "reference_sets": {
    "distribution_metrics": "data/processed/metadata/val.csv:positive_only",
    "train_memorization": "data/processed/metadata/train.csv:positive_only",
    "validation_similarity": "data/processed/metadata/val.csv:positive_only",
    "forbidden_splits": ["test", "historical_internal_test"]
  },
  "representations": ["raw", "filtered"],
  "comparison_rule": "Compare raw only with raw and filtered only with filtered; never mix representations in one ranking table.",
  "feature_spaces": {
    "inception_v3": {
      "role": "secondary standard-literature continuity",
      "metrics": ["fid", "kid", "precision", "recall", "density", "coverage"]
    },
    "rad_dino": {
      "role": "primary frozen medical-image feature extractor",
      "metrics": ["fid", "kid", "precision", "recall", "density", "coverage"],
      "frozen": true,
      "downstream_classifier": false,
      "limitation": "RAD-DINO is radiology-specific, not mammography-specific."
    }
  },
  "resampling": {
    "subsampling_fraction": 0.8,
    "stability_repetitions": 200,
    "kid_repetitions": 200,
    "prdc_repetitions": 100,
    "fid_repetitions": 1,
    "nearest_neighbour_k": 5,
    "replace": false,
    "percentiles": [2.5, 97.5],
    "interval_terminology": "repeated-subsampling stability interval",
    "shared_plan": "same real indices, subset size, seed schedule and representation policy for every generator",
    "report": ["mean", "median", "standard_deviation", "percentile_2_5", "percentile_97_5", "valid_repetitions"]
  },
  "embedding_cache": {
    "root": "results/publication_v2/generator_benchmark/embedding_cache",
    "key_fields": ["generator_id", "representation", "extractor"],
    "metadata_fields": ["schema_version", "image_ids", "image_paths", "image_fingerprints", "extractor", "extractor_model_id", "extractor_weights_identifier", "preprocessing_signature", "feature_dimension", "code_version", "source_manifest_path", "source_manifest_sha256", "metadata_csv_sha256"]
  },
  "memorization": {
    "train_pool": "generator_specific_declared_training_corpus",
    "validation_pool": "real_validation_positive",
    "synthetic_pool": "synthetic_same_candidate",
    "forbidden_pool": "test",
    "flag_rule": {"ssim_gte": 0.98, "perceptual_hash_distance_lte": 2},
    "gate_uses_train_only": true
  },
  "eligibility_gates": {
    "minimum_valid_positive_images": 1361,
    "maximum_exact_duplicate_rate": 0.01,
    "maximum_perceptual_duplicate_rate": 0.02,
    "maximum_train_memorization_rate": 0.01,
    "minimum_rad_dino_coverage": 0.5,
    "minimum_filter_acceptance_rate": 0.5,
    "maximum_corrupted_file_rate": 0.0,
    "require_complete_metrics": true,
    "require_lineage": true,
    "require_provenance": true,
    "forbid_test_access": true
  },
  "selection": {
    "one_per_family": ["finetuned", "from_scratch"],
    "primary_metric": "rad_dino.filtered.kid.full_reference",
    "fid_role": "secondary_descriptive",
    "weighted_composite_score": false,
    "practical_equivalence_margin": 0.001,
    "practical_equivalence_rule": "paired stability interval includes zero and absolute paired mean difference is no greater than the preregistered margin",
    "ranking": [
      {"metric": "rad_dino.filtered.kid.full_reference", "direction": "min"},
      {"metric": "rad_dino.filtered.coverage.mean", "direction": "max"},
      {"metric": "rad_dino.filtered.precision.mean", "direction": "max"},
      {"metric": "rad_dino.filtered.fid.mean", "direction": "min", "role": "descriptive_tiebreak"},
      {"metric": "inception_v3.filtered.kid.mean", "direction": "min"},
      {"metric": "rad_dino.filtered.kid.standard_deviation", "direction": "min"},
      {"metric": "generator_id", "direction": "lexicographic"}
    ],
    "manual_selection_required": true
  },
  "outputs": {
    "root": "results/publication_v2/generator_benchmark",
    "candidate_audit": "results/publication_v2/generator_benchmark/candidate_audit.csv",
    "technical_validity": "results/publication_v2/generator_benchmark/technical_validity.csv",
    "metrics": "results/publication_v2/generator_benchmark/generator_summary.csv",
    "ranking": "results/publication_v2/generator_benchmark/generator_ranking.csv",
    "resampling": "results/publication_v2/generator_benchmark/distribution_metrics_repetitions.csv",
    "resampling_plan": "results/publication_v2/generator_benchmark/resampling_plan.json",
    "paired_differences": "results/publication_v2/generator_benchmark/paired_generator_differences.csv",
    "distribution_summary": "results/publication_v2/generator_benchmark/distribution_metrics_summary.csv",
    "diversity": "results/publication_v2/generator_benchmark/diversity_metrics.csv",
    "train_memorization": "results/publication_v2/generator_benchmark/train_memorization.csv",
    "validation_similarity": "results/publication_v2/generator_benchmark/validation_similarity.csv",
    "synthetic_duplication": "results/publication_v2/generator_benchmark/synthetic_duplication.csv"
  }
}
